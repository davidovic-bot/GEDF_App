<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\User;
use App\Models\Role;
use App\Models\Service;
use App\Models\Parapheur;
use App\Models\AuditLog;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class AdminController extends Controller
{
    /**
     * Affiche le tableau de bord d'administration
     */
    public function index()
    {
        // Statistiques générales
        $stats = [
            'users' => [
                'total' => User::count(),
                'actifs' => User::where('actif', 1)->count(),
                'nouveaux' => User::whereDate('created_at', today())->count(),
            ],
            'roles' => [
                'total' => Role::count(),
                'liste' => Role::pluck('name'),
            ],
            'services' => [
                'total' => Service::count(),
            ],
            'parapheurs' => [
                'total' => Parapheur::count(),
                'en_cours' => Parapheur::whereIn('statut_actuel', [
                    'en_attente_analyse', 
                    'en_attente_chef_service', 
                    'en_attente_directeur'
                ])->count(),
                'valides' => Parapheur::where('statut_actuel', 'valide')->count(),
                'signes' => Parapheur::where('statut_actuel', 'signe')->count(),
                'rejetes' => Parapheur::where('statut_actuel', 'rejete')->count(),
            ],
        ];

        // Activité récente (dernières actions)
        $recentActivity = AuditLog::with('user')
            ->orderBy('created_at', 'desc')
            ->limit(10)
            ->get();

        // Statistiques par service
        $statsParService = Service::withCount([
            'parapheurs as parapheurs_total',
            'parapheurs as parapheurs_en_cours' => function($query) {
                $query->whereIn('statut_actuel', [
                    'en_attente_analyse', 
                    'en_attente_chef_service', 
                    'en_attente_directeur'
                ]);
            },
            'users as utilisateurs_count'
        ])->get();

        // Derniers utilisateurs inscrits
        $recentUsers = User::orderBy('created_at', 'desc')->limit(5)->get();

        // Derniers parapheurs
        $recentParapheurs = Parapheur::with(['service', 'courrier'])
            ->orderBy('created_at', 'desc')
            ->limit(5)
            ->get();

        return view('admin.dashboard', compact(
            'stats', 
            'recentActivity', 
            'statsParService',
            'recentUsers',
            'recentParapheurs'
        ));
    }

    /**
     * Affiche les logs d'audit
     */
    public function audit()
    {
        $logs = AuditLog::with('user')
            ->orderBy('created_at', 'desc')
            ->paginate(20);

        return view('admin.audit', compact('logs'));
    }

    /**
     * Nettoie le cache
     */
    public function clearCache()
    {
        try {
            \Artisan::call('cache:clear');
            \Artisan::call('config:clear');
            \Artisan::call('view:clear');
            
            return back()->with('success', 'Cache nettoyé avec succès !');
        } catch (\Exception $e) {
            return back()->with('error', 'Erreur lors du nettoyage du cache.');
        }
    }

    /**
     * Statistiques avancées
     */
    public function statistiques()
    {
        // Évolution des parapheurs par mois
        $evolutionParapheurs = Parapheur::select(
                DB::raw('MONTH(created_at) as mois'),
                DB::raw('YEAR(created_at) as annee'),
                DB::raw('count(*) as total')
            )
            ->whereYear('created_at', date('Y'))
            ->groupBy('annee', 'mois')
            ->orderBy('annee')
            ->orderBy('mois')
            ->get();

        // Top 5 des utilisateurs les plus actifs
        $topUsers = User::withCount('validations')
            ->orderBy('validations_count', 'desc')
            ->limit(5)
            ->get();

        return view('admin.statistiques', compact('evolutionParapheurs', 'topUsers'));
    }
}